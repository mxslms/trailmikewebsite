---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PageLayout
  title="Journal"
  description="All Trailmike journal entries — backpacking adventures and edge AI build notes."
>
  <section class="section page-intro">
    <div class="wrap">
      <p class="eyebrow fade-up">Journal</p>
      <h1 class="fade-up-delay">Everything in one feed</h1>
      <p class="lede fade-up-delay-2">
        Adventures and edge AI notes, newest first. Filter by section anytime from the nav.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</PageLayout>

<style>
  .page-intro {
    padding-bottom: 0;
  }

  h1 {
    margin: 0.35rem 0 0.85rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }

  .lede {
    max-width: 36rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 1.25rem;
  }

  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
